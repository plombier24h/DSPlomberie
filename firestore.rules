rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un compte email/mot de passe (console ou poste assistant).
    function connecte() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password';
    }
    // Administrateurs : peuvent modifier fiches, tarifs, catalogue, réglages.
    // Pour en ajouter un, ajouter son email à cette liste.
    function admin() {
      return connecte() && request.auth.token.email in ['plombierds24@gmail.com'];
    }

    // Appels visio : le visiteur anonyme crée son appel, la console répond.
    match /calls/{callId} {
      allow read, create, update: if request.auth != null;
      allow delete: if admin();
      match /{sub}/{candidateId} {
        allow read, create: if request.auth != null;
      }
    }

    // Référentiel métier : lecture par tous les comptes, écriture réservée aux admins.
    match /fiches/{docId}    { allow read: if connecte(); allow write: if admin(); }
    match /prix/{docId}      { allow read: if connecte(); allow write: if admin(); }
    match /catalogue/{docId} { allow read: if connecte(); allow write: if admin(); }
    match /reglages/{docId}  { allow read: if connecte(); allow write: if admin(); }

    // Transcriptions et notes : chaque poste crée les siennes, l'admin seul corrige ou supprime.
    match /diagnostics/{docId} {
      allow read:   if admin() || (connecte() && resource.data.auteur == request.auth.token.email);
      allow create: if connecte() && request.resource.data.auteur == request.auth.token.email;
      allow update, delete: if admin();
    }

    // Présence de la console visio.
    match /presence/{docId} {
      allow read: if request.auth != null;
      allow write: if admin();
    }
  }
}
